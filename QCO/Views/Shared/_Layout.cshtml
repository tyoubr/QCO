<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QCO</title>


    <!-- =========================================================
         BOOTSTRAP CSS
         ========================================================= -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =========================================================
         SITE CSS
         ========================================================= -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QCO.styles.css"
          asp-append-version="true" />


    <!-- =========================================================
         THIRD PARTY CSS
         ========================================================= -->
    <link rel="stylesheet"
          href="~/css/thirdparty.bundle.css" />


    <!-- =========================================================
         SELECT2 CSS
         ========================================================= -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" />


    <!-- =========================================================
         TOASTR CSS
         ========================================================= -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />


    <!-- =========================================================
         CUSTOM TOAST STYLE
         ========================================================= -->
    <style>

        #toast-container > .toast {
            opacity: 1 !important;
            color: #ffffff !important;
        }

        .toast-success {
            background-color: #51A351 !important;
        }

        .toast-error {
            background-color: #BD362F !important;
        }

        .toast-info {
            background-color: #2F96B4 !important;
        }

        .toast-warning {
            background-color: #F89406 !important;
        }

        /* =====================================================
                   GENERAL PAGE
                   ===================================================== */

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            padding: 0;
        }

        /* =====================================================
                   REPORT VIEWER
                   ===================================================== */

        .report-viewer-container {
            width: 100%;
            min-height: 800px;
            overflow: hidden;
        }

    </style>

</head>


<body>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">


                <!-- =================================================
                     BRAND
                     ================================================= -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    QCO

                </a>


                <!-- =================================================
                     MOBILE MENU BUTTON
                     ================================================= -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- =================================================
                     NAVIGATION
                     ================================================= -->

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">


                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <!-- =================================================
                             GET USERNAME
                             ================================================= -->
                        var userName = User.Identity?.Name ?? "";


                        <!-- =================================================
                             CAD USER CHECK
                             ================================================= -->
                        bool isCadUser =
                        userName.Contains(
                        "cad",
                        StringComparison.OrdinalIgnoreCase
                        );


                        <!-- =================================================
                             NAVIGATION MENU
                             ================================================= -->

                        <ul class="navbar-nav flex-grow-1">


                            @if (isCadUser)
                            {

                                <!-- =================================================
                                     CAD USER MENU
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="CAD"
                                       asp-action="Index">

                                        CAD Consumption

                                    </a>

                                </li>

                            }
                            else
                            {

                                <!-- =================================================
                                     HOME
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Index">

                                        Home

                                    </a>

                                </li>


                                <!-- =================================================
                                     LAYOUT MONITORING
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="LayoutMonitoringSheets"
                                       asp-action="Index">

                                        Layout Monitoring Sheets

                                    </a>

                                </li>


                                <!-- =================================================
                                     CAUSE OF DELAY
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Cause_Of_Delay"
                                       asp-action="Index">

                                        Cause Of Delay

                                    </a>

                                </li>


                                <!-- =================================================
                                     HIT RATE REPORT
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="ReportCalling"
                                       asp-action="Viewer"
                                       asp-route-reportName="rptHitRate">

                                        HIT Rate Report

                                    </a>

                                </li>


                                <!-- =================================================
                                     LAYOUT MONITORING REPORT
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="ReportCalling"
                                       asp-action="Viewer"
                                       asp-route-reportName="rptLayoutMonitoringSheet">

                                        Layout Monitoring Report

                                    </a>

                                </li>


                                <!-- =================================================
                                     SEWING EFFICIENCY
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="SewingEfficiency"
                                       asp-action="SewingEfficiencyList">

                                        Sewing Efficiency

                                    </a>

                                </li>


                                <!-- =================================================
                                     RECAP
                                     ================================================= -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="RecapeInfo"
                                       asp-action="RecapeInfoList">

                                        Recap

                                    </a>

                                </li>

                            }

                        </ul>

                    }


                    <!-- =================================================
                         LOGIN / LOGOUT
                         ================================================= -->

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <main role="main"
          class="pb-3">

        <div class="container-fluid">

            @RenderBody()

        </div>

    </main>


    <!-- =========================================================
         JAVASCRIPT
         IMPORTANT:
         jQuery MUST load before scripts that depend on jQuery.
         ========================================================= -->
    <!-- =========================================================
         JQUERY
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <!-- =========================================================
         THIRD PARTY JS
         ========================================================= -->

    <script src="~/js/thirdparty.bundle.js"></script>


    <!-- =========================================================
         BOOTSTRAP JS
         ========================================================= -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================================================
         SELECT2 JS
         ========================================================= -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js">
    </script>


    <!-- =========================================================
         TOASTR JS
         ========================================================= -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js">
    </script>


    <!-- =========================================================
         TOASTR CONFIGURATION
         ========================================================= -->

    <script>

        $(document).ready(function () {

            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass: "toast-top-right",

                preventDuplicates: true,

                timeOut: 3000,

                extendedTimeOut: 1000

            };


            // =====================================================
            // SUCCESS MESSAGE
            // =====================================================

            var successMessage =
                @Html.Raw(Json.Serialize(TempData["Success"]));


            // =====================================================
            // ERROR MESSAGE
            // =====================================================

            var errorMessage =
                @Html.Raw(Json.Serialize(TempData["Error"]));


            // =====================================================
            // SHOW SUCCESS
            // =====================================================

            if (successMessage) {

                toastr.success(successMessage);

            }


            // =====================================================
            // SHOW ERROR
            // =====================================================

            if (errorMessage) {

                toastr.error(errorMessage);

            }

        });

    </script>


    <!-- =========================================================
         PAGE SPECIFIC SCRIPTS
         ========================================================= -->
    @await RenderSectionAsync(
    "Scripts",
        required: false
        )


</body>

</html>
