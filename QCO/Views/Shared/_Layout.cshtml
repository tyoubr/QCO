<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QCO</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QCO.styles.css"
          asp-append-version="true" />

    <!-- Third Party CSS -->
    <link rel="stylesheet"
          href="~/css/thirdparty.bundle.css" />

    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <!-- Select2 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css"
          rel="stylesheet" />

    <style>

        #toast-container > .toast {
            opacity: 1;
            color: #fff;
        }

        .toast-success {
            background-color: #51A351 !important;
        }

        .toast-error {
            background-color: #BD362F !important;
        }

        .toast-info {
            background-color: #2F96B4 !important;
        }

        .toast-warning {
            background-color: #F89406 !important;
        }

    </style>

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- BRAND -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    QCO

                </a>


                <!-- MOBILE TOGGLE -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        /*
                        * ============================================================
                        * USER NAME
                        * ============================================================
                        *
                        * Example:
                        *
                        * tkl@cad.com
                        *
                        * Contains "cad" => CAD USER
                        *
                        */

                        var userName = User.Identity?.Name ?? "";

                        bool isCadUser =
                        userName.Contains(
                        "cad",
                        StringComparison.OrdinalIgnoreCase
                        );


                        /*
                        * ============================================================
                        * NAVIGATION MENU
                        * ============================================================
                        */

                        <ul class="navbar-nav flex-grow-1">


                            @* =========================================================
                               CAD USER
                               ---------------------------------------------------------
                               If username contains "cad", ONLY CAD menu will show.
                               Example:
                               tkl@cad.com
                               cad01@rh.com
                               user_cad
                               CAD.admin
                               ========================================================= *@

                            @if (isCadUser)
                            {

                                <!-- ONLY CAD -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="CAD"
                                       asp-action="Index">

                                        CAD Consumption

                                    </a>

                                </li>

                            }
                            else
                            {

                                @* =====================================================
                                   NORMAL USER MENU
                                   -----------------------------------------------------
                                   Users whose username does NOT contain "cad"
                                   will see the normal QCO menus.
                                   ===================================================== *@


                                <!-- HOME -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Index">

                                        Home

                                    </a>

                                </li>


                                <!-- LAYOUT MONITORING -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="LayoutMonitoringSheets"
                                       asp-action="Index">

                                        Layout Monitoring Sheets

                                    </a>

                                </li>


                                <!-- CAUSE OF DELAY -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Cause_Of_Delay"
                                       asp-action="Index">

                                        Cause Of Delay

                                    </a>

                                </li>


                                <!-- HIT RATE REPORT -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="ReportCalling"
                                       asp-action="Viewer"
                                       asp-route-reportName="rptHitRate">

                                        HIT Rate Report

                                    </a>

                                </li>


                                <!-- LAYOUT MONITORING REPORT -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="ReportCalling"
                                       asp-action="Viewer"
                                       asp-route-reportName="rptLayoutMonitoringSheet">

                                        Layout Monitoring Report

                                    </a>

                                </li>


                                <!-- SEWING EFFICIENCY -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="SewingEfficiency"
                                       asp-action="SewingEfficiencyList">

                                        Sewing Efficiency

                                    </a>

                                </li>


                                <!-- RECAP -->

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="RecapeInfo"
                                       asp-action="RecapeInfoList">

                                        Recap

                                    </a>

                                </li>

                            }

                        </ul>

                    }


                    <!-- LOGIN / LOGOUT -->

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->

    <div class="container-fluid">

        @RenderBody()

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->
    <!-- Third Party JS -->

    <script src="~/js/thirdparty.bundle.js"></script>


    <!-- jQuery -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <!-- Bootstrap -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Select2 -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>


    <!-- Toastr -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>


    <!-- =========================================================
         TOASTR
         ========================================================= -->

    <script>

        $(function () {

            toastr.options = {

                positionClass: "toast-top-right",

                timeOut: "3000"

            };


            var success =
                @Html.Raw(Json.Serialize(TempData["Success"]));


            var error =
                @Html.Raw(Json.Serialize(TempData["Error"]));


            if (success) {

                toastr.success(success);

            }


            if (error) {

                toastr.error(error);

            }

        });

    </script>


    <!-- =========================================================
         PAGE SPECIFIC SCRIPTS
         ========================================================= -->
    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>
