@model QCO.ViewModel.CadConsumptionViewModel

@{
    ViewData["Title"] = "CAD Consumption Details";
}

<style>
    .details-container {
        max-width: 1600px;
        margin: 0 auto;
    }

    .info-table th {
        width: 18%;
        background-color: #f8f9fc;
        color: #495057;
        font-weight: 600;
    }

    .info-table td {
        width: 32%;
    }

    .detail-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 20px;
        overflow: hidden;
        background-color: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .detail-card-header {
        background: linear-gradient(to right, #4e73df, #1cc88a);
        color: white;
        padding: 10px 15px;
        font-weight: 600;
    }

    .detail-table {
        margin-bottom: 0;
    }

        .detail-table th {
            width: 25%;
            background-color: #f8f9fc;
            color: #495057;
            font-weight: 600;
        }

        .detail-table td {
            width: 25%;
        }

    .file-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        padding: 7px 10px;
        background-color: #f8f9fa;
        border-radius: 6px;
        border: 1px solid #e9ecef;
    }

    .file-name {
        flex: 1;
        word-break: break-word;
    }
</style>

<h2 class="text-primary text-center">CAD Consumption Details</h2>
<hr />

<div class="container-fluid bg-light p-4 rounded shadow-sm details-container">

    <!-- ========================= -->
    <!-- MASTER INFORMATION -->
    <!-- ========================= -->

    <h4 class="text-success mb-3">
        General Information
    </h4>

    <div class="table-responsive">
        <table class="table table-bordered info-table bg-white">
            <tbody>

                <tr>
                    <th>CAD Date</th>
                    <td>
                        @(Model.Master?.Caddate?.ToString("dd-MM-yyyy") ?? "")
                    </td>

                    <th>Working Company</th>
                    <td>
                        @Model.Master?.Opt01
                    </td>
                </tr>

                <tr>
                    <th>Style Ref</th>
                    <td>
                        @Model.Master?.Styleref
                    </td>

                    <th>Job No.</th>
                    <td>
                        @Model.Master?.Job
                    </td>
                </tr>

                <tr>
                    <th>IR/IB</th>
                    <td>
                        @Model.Master?.Ir
                    </td>

                    <th>Buyer</th>
                    <td>
                        @Model.Master?.Buyer
                    </td>
                </tr>

                <tr>
                    <th>Brand</th>
                    <td>
                        @Model.Master?.Brand
                    </td>

                    <th>Season</th>
                    <td>
                        @Model.Master?.Season
                    </td>
                </tr>

                <tr>
                    <th>Season Year</th>
                    <td>
                        @Model.Master?.Seasonyear
                    </td>

                    <th>Consumption For</th>
                    <td>
                        @Model.Master?.Consfor
                    </td>
                </tr>

                <tr>
                    <th>Pattern Master</th>
                    <td>
                        @Model.Master?.Patternmaster
                    </td>

                    <th>Approval Status</th>
                    <td>
                        @if (Model.Master?.Isapproved == true)
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending Approval
                            </span>
                        }
                    </td>
                </tr>

                <tr>
                    <th>Style Description</th>
                    <td colspan="3">
                        @Model.Master?.Styledes
                    </td>
                </tr>

                <tr>
                    <th>Comments</th>
                    <td colspan="3">
                        @Model.Master?.Comments
                    </td>
                </tr>

            </tbody>
        </table>
    </div>


    <!-- ========================= -->
    <!-- MARKER DETAILS -->
    <!-- ========================= -->

    <h4 class="text-success mt-4 mb-3">
        Marker Details
    </h4>

    @if (Model.Details != null && Model.Details.Any())
    {
        for (int i = 0; i < Model.Details.Count; i++)
        {
            var item = Model.Details[i];

            <div class="detail-card">

                <!-- Detail Header -->
                <div class="detail-card-header">
                    Marker #@(i + 1)

                    @if (!string.IsNullOrWhiteSpace(item.Ptnnmbr))
                    {
                        <span class="ms-2">
                            | Pattern No: @item.Ptnnmbr
                        </span>
                    }
                </div>

                <div class="table-responsive">

                    <table class="table table-bordered detail-table">

                        <tbody>

                            <!-- Row 1 -->
                            <tr>
                                <th>Pattern No.</th>
                                <td>
                                    @item.Ptnnmbr
                                </td>

                                <th>Garments Item</th>
                                <td>
                                    @item.Gmntitem
                                </td>
                            </tr>

                            <!-- Row 2 -->
                            <tr>
                                <th>Garments Color</th>
                                <td>
                                    @item.Gmntcolor
                                </td>

                                <th>Fabric Description</th>
                                <td>
                                    @item.Fabricdes
                                </td>
                            </tr>

                            <!-- Row 3 -->
                            <tr>
                                <th>Body Parts / Fabric Usage</th>
                                <td>
                                    @item.Fabricusage
                                </td>

                                <th>GSM</th>
                                <td>
                                    @item.Gsm
                                </td>
                            </tr>

                            <!-- Row 4 -->
                            <tr>
                                <th>Marker Length</th>
                                <td>
                                    @item.Opt01
                                </td>

                                <th>Full Width</th>
                                <td>
                                    @item.Fullwidth
                                </td>
                            </tr>

                            <!-- Row 5 -->
                            <tr>
                                <th>Cut Width</th>
                                <td>
                                    @item.Cutwidth
                                </td>

                                <th>Efficiency %</th>
                                <td>
                                    @item.Efficiency
                                </td>
                            </tr>

                            <!-- Row 6 -->
                            <tr>
                                <th>Size Ratio</th>
                                <td>
                                    @item.Sizeratio
                                </td>

                                <th>Marker Qty</th>
                                <td>
                                    @item.Markerqty
                                </td>
                            </tr>

                            <!-- Row 7 -->
                            <tr>
                                <th>Wastage %</th>
                                <td>
                                    @item.Wastage
                                </td>

                                <th>Consumption / Pcs</th>
                                <td>
                                    @item.Conspcs
                                </td>
                            </tr>

                            <!-- Row 8 -->
                            <tr>
                                <th>Consumption / Dzn</th>
                                <td>
                                    @item.Consdzn
                                </td>

                                <th>Comments</th>
                                <td>
                                    @item.Comments
                                </td>
                            </tr>

                            <!-- ========================= -->
                            <!-- FILES -->
                            <!-- ========================= -->

                            <tr>
                                <th>Uploaded Files</th>

                                <td colspan="3">

                                    @if (item.ExistingFiles != null &&
                                                                item.ExistingFiles.Any())
                                    {
                                        foreach (var file in item.ExistingFiles)
                                        {
                                            var fileName =
                                            System.IO.Path.GetFileName(
                                            file.Filepath ?? ""
                                            );

                                            var originalName =
                                            fileName.Contains("_")
                                            ? fileName.Substring(
                                            fileName.IndexOf("_") + 1)
                                            : fileName;

                                            <div class="file-item">

                                                <span class="file-name">
                                                    📄 @originalName
                                                </span>

                                                <a asp-controller="CAD"
                                                   asp-action="ViewFile"
                                                   asp-route-id="@file.Fileid"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-success">
                                                    View
                                                </a>

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No files uploaded.
                                        </span>
                                    }

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            No marker details found.
        </div>
    }


    <!-- ========================= -->
    <!-- BACK BUTTON -->
    <!-- ========================= -->

    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back to List
        </a>

    </div>

</div>
