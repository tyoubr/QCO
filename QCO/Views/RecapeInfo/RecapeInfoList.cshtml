@model IEnumerable<QCO.Models.TblRecapMaster>

@{
    ViewData["Title"] = "Recap Information List";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    int pageSize = 15;
    int sl = (currentPage - 1) * pageSize;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="container-fluid">

    <!-- TITLE --> 
<h3 class="mb-3 text-center">
    Recap Information List
</h3>



    <!-- SEARCH / ACTION -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <!-- SEARCH -->
        <form method="get"
              asp-action="RecapeInfoList"
              class="d-flex gap-2 align-items-center">

            <input type="text"
                   name="searchString"
                   id="searchBox"
                   value="@ViewBag.SearchString"
                   class="form-control"
                   placeholder="Search here..."
                   style="max-width: 350px;" />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

        </form>

        <!-- ACTION BUTTONS -->
        <div class="d-flex gap-2">

            <a asp-action="Create"
               class="btn btn-primary">
                + Create
            </a>

            <button type="button"
                    class="btn btn-secondary"
                    onclick="window.history.back();">
                Back
            </button>

        </div>

    </div>

    <!-- TOTAL RECORDS -->
    <div class="mb-2">
        <strong>Total Records:</strong>
        @ViewBag.TotalRecapInfo
    </div>

    <!-- TABLE -->
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead class="table-info text-center">
                <tr>
                    <th>SL</th>
                    <th>Style Name</th>
                    <th>Buyer Name</th>
                    <th>Booking No.</th>
                    <th>PO No.</th>
                    <th>Recap Month</th>
                    <th>Recap Year</th>
                    <th>Fac. Shipment Date</th>
                    <th>Act. Shipment Date</th>
                    <th>Submission Date</th>
                    <th>Is Tagged?</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        sl++;

                        <tr class="text-center">
                            <td>@sl</td>
                            <td>@item.StyleName</td>
                            <td>@item.BuyerName</td>
                            <td>@item.BookingNo</td>
                            <td>@item.PoNo</td>
                            <td>@item.RecapMonth</td>
                            <td>@item.RecapeYear</td>

                            <td>
                                @item.FacShipmentDate?.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @item.ActShipmentDate?.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @item.SubmissionDate?.ToString("dd-MM-yyyy")
                            </td>
                            <td class="text-center">

                                @if (item.Remarks?.Equals("Tagged", StringComparison.OrdinalIgnoreCase) == true)
                                {
                                    <span class="badge rounded-pill bg-success px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Tagged
                                    </span>
                                }
                                else if (item.Remarks?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true)
                                {
                                    <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                        <i class="bi bi-clock me-1"></i>
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3 py-2">
                                        @item.Remarks
                                    </span>
                                }
                            
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Rcmid"
                                       class="btn btn-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Rcmid"
                                       class="btn btn-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12"
                            class="text-center text-muted py-4">
                            No recap information found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- PAGINATION -->

    @if (totalPages > 1)
    {
        <nav aria-label="Recap pagination">

            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("RecapeInfoList",
                           new {
                               page = currentPage - 1,
                               searchString = ViewBag.SearchString
                           })">
                        Previous
                    </a>
                </li>

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("RecapeInfoList",
                               new {
                                   page = i,
                                   searchString = ViewBag.SearchString
                               })">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("RecapeInfoList",
                           new {
                               page = currentPage + 1,
                               searchString = ViewBag.SearchString
                           })">
                        Next
                    </a>
                </li>

            </ul>

        </nav>
    }

</div>

